{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "{{unet}}", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "{{clip_l}}", "clip_name2": "{{clip_t5}}", "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "{{vae}}"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "{{negative_prompt}}", "clip": ["2", 0]}
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {"image": "{{input_image}}", "upload": "image"}
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": {"pixels": ["6", 0], "vae": ["3", 0]}
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0], "positive": ["4", 0], "negative": ["5", 0],
      "latent_image": ["7", 0], "seed": "{{seed}}", "steps": "{{steps}}",
      "cfg": "{{cfg}}", "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}", "denoise": "{{denoise}}"
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]}
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {"filename_prefix": "gimp-comfyui-flux", "images": ["9", 0]}
  }
}
